# Firebase web app keys (Firebase console → Project settings → Your apps → Web app)
# Copy this file to .env.local and fill the values. On Vercel add the same names in Project → Settings → Environment Variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
